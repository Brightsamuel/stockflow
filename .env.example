# Copy this file to .env and fill in real values. Never commit .env.

# Pooled connection used by the app (Neon: the "Pooled connection" string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=30"

# Direct connection used for migrations (Neon: turn "Connection pooling" off and copy that string)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=30"

# Long random string that signs sign-in sessions. Changing it signs everyone out.
SESSION_SECRET="replace-with-a-long-random-string"
