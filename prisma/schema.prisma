generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  trackLogs Boolean  @default(false)
  isSystem  Boolean  @default(false) // hidden category that holds the "Opening balance" store
  stores    Store[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id           String       @id @default(cuid())
  name         String
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  entries      StockEntry[]
  transfersOut Transfer[]   @relation("SourceStore")
  transfersIn  Transfer[]   @relation("TargetStore")
  logs         StockLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([name, categoryId])
}

// Master unit catalogue — e.g. kg, litre, pair, bag
model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

// Master product catalogue — created once, used across all stores
model Product {
  id        String       @id @default(cuid())
  name      String       @unique
  unitId    String
  unit      Unit         @relation(fields: [unitId], references: [id])
  // Opening balance as entered in Manage Products; what remains lives in the opening store's StockEntry
  openingQty  Float      @default(0)
  openingRate Float      @default(0)
  entries   StockEntry[]
  logs      StockLog[]
  transfers Transfer[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// One row per product per store — holds current balance and rate
// Rate is per-store and can change over time via new stock-ins
model StockEntry {
  id         String    @id @default(cuid())
  productId  String
  storeId    String
  rate       Float
  quantity   Float
  lowStockAt Float     @default(0)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  ownerId    String     @default("unassigned") // each owner's stock of a product is its own row
  product    Product    @relation(fields: [productId], references: [id])
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner      StockOwner @relation(fields: [ownerId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([productId, storeId, ownerId])
}

// Every movement is written here — immutable audit trail
model StockLog {
  id          String     @id @default(cuid())
  storeId     String
  productId   String
  type        String
  quantity    Float
  rate        Float
  note        String?
  refNo       String?
  entryDate   DateTime   @default(now())
  userId      String?
  recipientId String?
  ownerId     String     @default("unassigned")
  projectId   String?    // set when stock is issued to a project (used in the field)
  takenBy     String?    // who collected the stock on a stock out
  adjustment  Float?     // signed change to the store balance made by an EDIT, DELETE or RESTORE
  deletionId  String?    // set while the note this line belongs to is deleted; such lines no longer count
  store       Store      @relation(fields: [storeId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipient   Recipient? @relation(fields: [recipientId], references: [id])
  owner       StockOwner @relation(fields: [ownerId], references: [id])
  project     Project?   @relation(fields: [projectId], references: [id])
  deletion    Deletion?  @relation(fields: [deletionId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())

  @@index([deletionId])
}

model Transfer {
  id            String     @id @default(cuid())
  sourceStoreId String
  targetStoreId String?
  recipientId   String?
  productId     String
  quantity      Float
  userId        String?
  ownerId       String     @default("unassigned")
  projectId     String?
  takenBy       String?
  refNo         String?
  entryDate     DateTime   @default(now())
  deletionId    String?    // set while the note this line belongs to is deleted
  createdAt     DateTime   @default(now())

  sourceStore Store      @relation("SourceStore", fields: [sourceStoreId], references: [id])
  targetStore Store?     @relation("TargetStore", fields: [targetStoreId], references: [id])
  recipient   Recipient? @relation(fields: [recipientId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  owner       StockOwner @relation(fields: [ownerId], references: [id])
  project     Project?   @relation(fields: [projectId], references: [id])
  deletion    Deletion?  @relation(fields: [deletionId], references: [id], onDelete: Restrict)

  @@index([deletionId])
}

// A received, issue or transfer note deleted as a whole (Super admin). Its log lines and transfer
// rows stay in the database pointing here and are left out of stock, reports, product history and
// documents; restoring the deletion counts them again. Deletions are never removed, so this is
// also the record of who deleted what, when and why, and who restored it.
model Deletion {
  id           String     @id @default(cuid())
  kind         String     // RECEIPT | FIELD | EXTERNAL | TRANSFER (see lib/notes)
  refNo        String?
  title        String     // e.g. "Goods Received Note"
  summary      String     // e.g. "Main Store → Site A"
  itemCount    Int
  value        Float
  entryDate    DateTime   // the note's date (its first line's, when it spans several days)
  reason       String
  document     Json       // the note as it read when deleted, for viewing afterwards
  removedRows  Json?      // store rows the deletion emptied and removed, so a restore can put them back
  userId       String?
  user         User?      @relation("DeletedBy", fields: [userId], references: [id], onDelete: SetNull)
  restoredAt   DateTime?
  restoredById String?
  restoredBy   User?      @relation("RestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)
  logs         StockLog[]
  transfers    Transfer[]
  createdAt    DateTime   @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String     @default("STANDARD") // "STANDARD" | "ADMIN" | "SUPER_ADMIN"
  isActive     Boolean    @default(true)
  sessionVersion Int      @default(0) // bumped on a password change, reset or deactivation to end old sessions
  failedLogins Int        @default(0)
  lockedUntil  DateTime?  // set after too many failed sign-ins
  createdAt    DateTime @default(now())
  stockLogs    StockLog[]
  transfers    Transfer[]
  deletions    Deletion[] @relation("DeletedBy")
  restorations Deletion[] @relation("RestoredBy")
}

model Recipient {
  id        String     @id @default(cuid())
  name      String
  company   String?
  createdAt DateTime   @default(now())
  transfers Transfer[]
  logs      StockLog[]
}

// Who a batch of stock belongs to. The built-in "unassigned" row means no owner.
model StockOwner {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  entries   StockEntry[]
  logs      StockLog[]
  transfers Transfer[]
}

// A job/site that stock is issued to for use in the field (field records)
model Project {
  id        String     @id @default(cuid())
  name      String     @unique
  location  String?
  createdAt DateTime   @default(now())
  logs      StockLog[]
  transfers Transfer[]
}

model Settings {
  id          String  @id @default("singleton")
  companyName String?
  address     String?
  phone       String?
  email       String?
  logoUrl     String?
}

