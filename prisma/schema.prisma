generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  trackLogs Boolean  @default(false)
  stores    Store[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id           String       @id @default(cuid())
  name         String
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  entries      StockEntry[]
  transfersOut Transfer[]   @relation("SourceStore")
  transfersIn  Transfer[]   @relation("TargetStore")
  logs         StockLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([name, categoryId])
}

// Master unit catalogue — e.g. kg, litre, pair, bag
model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

// Master product catalogue — created once, used across all stores
model Product {
  id        String       @id @default(cuid())
  name      String       @unique
  unitId    String
  unit      Unit         @relation(fields: [unitId], references: [id])
  entries   StockEntry[]
  logs      StockLog[]
  transfers Transfer[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// One row per product per store — holds current balance and rate
// Rate is per-store and can change over time via new stock-ins
model StockEntry {
  id         String    @id @default(cuid())
  productId  String
  storeId    String
  rate       Float
  quantity   Float
  lowStockAt Float     @default(0)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  product    Product   @relation(fields: [productId], references: [id])
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([productId, storeId])
}

// Every movement is written here — immutable audit trail
model StockLog {
  id          String     @id @default(cuid())
  storeId     String
  productId   String
  type        String
  quantity    Float
  rate        Float
  note        String?
  refNo       String?
  userId      String?
  recipientId String?
  store       Store      @relation(fields: [storeId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipient   Recipient? @relation(fields: [recipientId], references: [id])
  createdAt   DateTime   @default(now())
}

model Transfer {
  id            String     @id @default(cuid())
  sourceStoreId String
  targetStoreId String?
  recipientId   String?
  productId     String
  quantity      Float
  userId        String?
  createdAt     DateTime   @default(now())

  sourceStore Store      @relation("SourceStore", fields: [sourceStoreId], references: [id])
  targetStore Store?     @relation("TargetStore", fields: [targetStoreId], references: [id])
  recipient   Recipient? @relation(fields: [recipientId], references: [id])
  product     Product    @relation(fields: [productId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String     @default("STANDARD") // "STANDARD" | "ADMIN" | "SUPER_ADMIN"
  isActive     Boolean    @default(true)
  createdAt    DateTime @default(now())
  stockLogs    StockLog[]
  transfers    Transfer[]
}

model Recipient {
  id        String     @id @default(cuid())
  name      String
  company   String?
  createdAt DateTime   @default(now())
  transfers Transfer[]
  logs      StockLog[]
}

model Settings {
  id          String  @id @default("singleton")
  companyName String?
  address     String?
  phone       String?
  email       String?
  logoUrl     String?
}

